# Enforce consistent LF line endings across WSL2 and Windows
* text=auto eol=lf

# Explicit LF for text/code/config files
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.html text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.ini text eol=lf
*.txt text eol=lf

# Binary artifacts (prevent git diff/CRLF corruption)
*.parquet binary
*.npy binary
*.joblib binary
*.pptx binary
*.png binary
*.pdf binary
